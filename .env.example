# Copy this file to .env and change the values if you want.
# docker-compose.yml reads the same file to create the database.
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
# 5433 and not the usual 5432, in case PostgreSQL is already installed on your computer
DB_PORT=5433
DB_NAME=found_in_aui

# Used to sign the login cookie. Put any long random text here.
SESSION_SECRET=change-me-to-a-long-random-string

PORT=3000
